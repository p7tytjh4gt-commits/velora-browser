{
  "name": "velora-browser",
  "version": "0.3.0",
  "description": "A calm personal desktop browser",
  "main": "main.js",
  "private": true,
  "author": "Velora",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "test": "node --test",
    "test:app": "electron smoke.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.velora.browser",
    "productName": "Velora",
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "index.html",
      "ui.js",
      "style.css",
      "audio.js",
      "icons.js",
      "motion.js",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "artifactName": "Velora-${version}-${arch}.${ext}"
  }
}
